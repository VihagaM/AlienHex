# ── Server ────────────────────────────────────────────
PORT=3001
# Origin(s) allowed to open the dashboard socket / call the API (comma-separated)
CLIENT_ORIGIN
# Protects the dashboard (QR code, restart, logout). STRONGLY recommended.
# Leave empty to disable auth (local use only).
DASHBOARD_TOKEN=080858

# ── Bot ───────────────────────────────────────────────
BOT_NAME=AlienHex
PREFIX=.
# Owner number: country code + number, digits only (e.g. 94771234567)
OWNER_NUMBER=765516398
OWNER_NAME=Mr.Hex
# true  = anyone can use commands
# false = only the owner / the linked account itself can use commands
PUBLIC_MODE=true
# Start the WhatsApp connection automatically when the server boots
AUTO_START=true
# Ignore messages older than this many seconds (avoids replaying old commands after downtime)
MAX_MESSAGE_AGE_SECONDS=60

# ── Storage ───────────────────────────────────────────
# Folder where the WhatsApp session is persisted (relative to /backend)
AUTH_DIR=auth_session

# ── Logging ───────────────────────────────────────────
# Baileys internal logger level: silent | error | warn | info | debug
BAILEYS_LOG_LEVEL=silent
